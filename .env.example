# Public application origin. This value is safe to expose to browser code.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:5400

# Server fallback timezone for infrastructure-level timestamps only.
# Learner study-day/timezone will be owned by user profile/domain logic later.
APP_TIMEZONE=UTC

# Test-only behavior switch. Keep false for ordinary development and production.
LINGO_TEST_MODE=false

# Server-only PostgreSQL connection for the local development database.
# Credentials below are synthetic and exist only for the local Compose service.
DATABASE_URL=postgresql://lingo_pilot:lingo_pilot_local@127.0.0.1:5435/lingo_pilot_dev

# Server-only isolated database used exclusively by integration tests.
TEST_DATABASE_URL=postgresql://lingo_pilot:lingo_pilot_local@127.0.0.1:5435/lingo_pilot_test

# Auth/provider variables are introduced by their owning issues.
