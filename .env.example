# Public application origin. This value is safe to expose to browser code.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:5400

# Server fallback timezone for infrastructure-level timestamps only.
# Learner study-day/timezone will be owned by user profile/domain logic later.
APP_TIMEZONE=UTC

# Test-only behavior switch. Keep false for ordinary development and production.
LINGO_TEST_MODE=false

# Database/auth/provider variables are introduced by their owning issues.
