  "estimatedMinutes": 8,
  "objectives": [{"id": "objective.a0.008.form-be-question", "description": {"pt-BR": "Transformar uma frase afirmativa simples com be em pergunta de sim ou não."}}],
  "prerequisiteLessonIds": ["lesson.a0.007.be-negative"],
  "introducesConceptIds": ["concept.a0.grammar.be-questions"],
  "reinforcesConceptIds": ["concept.a0.grammar.be-affirmative", "concept.a0.grammar.subject-pronouns"],
