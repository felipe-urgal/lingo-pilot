  "blocks": [
    {
      "id": "block.a0.036.frequency-adverbs.explanation",
      "type": "explanation",
      "text": { "pt-BR": "Always, usually, sometimes e never dizem com que frequência algo acontece. Com os verbos desta unidade, coloque o advérbio normalmente antes do verbo principal." }
    },
    {
      "id": "block.a0.036.frequency-adverbs.vocabulary",
      "type": "vocabulary",
      "text": { "pt-BR": "always = sempre; usually = geralmente; sometimes = às vezes; never = nunca." }
    },
    {
      "id": "block.a0.036.frequency-adverbs.example",
      "type": "example",
      "language": "en",
      "text": { "en": "I always study. She usually works. We sometimes study. They never work." }
    },
    {
      "id": "block.a0.036.frequency-adverbs.checkpoint",
      "type": "checkpoint",
      "text": { "pt-BR": "Neste recorte, pratique a posição com verbos de ação já conhecidos; outros padrões podem ser revisados em unidades posteriores." }
    }
  ],
