    {"id":"block.a0.042.describe-people.vocabulary","type":"vocabulary","text":{"pt-BR":"tall = alto; short = baixo; hair = cabelo; eyes = olhos."}},
    {"id":"block.a0.042.describe-people.example","type":"example","language":"en","text":{"en":"She is tall. She has black hair."}},
    {"id":"block.a0.042.describe-people.checkpoint","type":"checkpoint","text":{"pt-BR":"Antes de formar a frase, decida se a ideia pede be (é/está) ou have/has (tem)."}}
