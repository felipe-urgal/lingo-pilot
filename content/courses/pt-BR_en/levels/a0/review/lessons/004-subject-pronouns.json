  "blocks": [
    {
      "id": "block.a0.004.pronouns.explanation",
      "type": "explanation",
      "text": {
        "pt-BR": "I = eu; you = você/vocês; he = ele; she = ela; it é usado para coisas e, conforme o contexto, animais; we = nós; they = eles/elas."
      }
    },
    {
      "id": "block.a0.004.pronouns.example",
      "type": "example",
      "language": "en",
      "text": {
        "en": "Ana is from Brazil. She is from Brazil."
      }
    },
    {
      "id": "block.a0.004.pronouns.common-error",
      "type": "common-error",
      "text": {
        "pt-BR": "Em inglês, o sujeito normalmente aparece de forma explícita. Escolha o pronome antes de decidir a forma do verbo."
      }
    }
  ],
  "activityIds": ["activity.a0.004.choose-she"]
