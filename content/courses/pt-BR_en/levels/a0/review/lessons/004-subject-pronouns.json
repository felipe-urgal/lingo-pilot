      "id": "objective.a0.004.choose-subject-pronoun",
      "description": {
        "pt-BR": "Escolher I, you, he, she, it, we ou they para um referente simples."
      }
    }
  ],
  "prerequisiteLessonIds": ["lesson.a0.003.self-introduction"],
  "introducesConceptIds": ["concept.a0.grammar.subject-pronouns"],
  "reinforcesConceptIds": [],
