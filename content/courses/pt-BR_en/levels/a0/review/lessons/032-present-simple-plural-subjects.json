  "blocks": [
    {
      "id": "block.a0.032.present-simple-base.explanation",
      "type": "explanation",
      "text": {
        "pt-BR": "Com I, you, we e they, use o verbo na forma base para falar de ações habituais e fatos simples."
      }
    },
    {
      "id": "block.a0.032.present-simple-base.rule",
      "type": "rule",
      "text": { "pt-BR": "I/You/We/They + verbo base." }
    },
    {
      "id": "block.a0.032.present-simple-base.example",
      "type": "example",
      "language": "en",
      "text": { "en": "I study. You work. We live. They eat." }
    },
    {
      "id": "block.a0.032.present-simple-base.checkpoint",
      "type": "checkpoint",
      "text": { "pt-BR": "Não acrescente -s ao verbo com I, you, we ou they." }
    }
  ],
  "activityIds": ["activity.a0.032.use-present-simple-base"]
