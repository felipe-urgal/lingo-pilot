    {
      "id": "objective.a0.032.use-present-simple-base",
      "description": {
        "pt-BR": "Descrever ações e fatos simples com I, you, we e they mais a forma base do verbo."
      }
    }
  ],
  "prerequisiteLessonIds": ["lesson.a0.031.essential-verbs"],
  "introducesConceptIds": ["concept.a0.grammar.present-simple-base"],
