    {
      "id": "objective.a0.037.describe-daily-routine",
      "description": {
        "pt-BR": "Combinar presente simples, horários e frequência para descrever uma ação da rotina."
      }
    }
  ],
  "prerequisiteLessonIds": ["lesson.a0.036.frequency-adverbs"],
  "introducesConceptIds": ["concept.a0.communication.daily-routine"],
  "reinforcesConceptIds": [
    "concept.a0.grammar.present-simple-base",
    "concept.a0.time.clock-time",
    "concept.a0.grammar.frequency-adverbs"
  ],
