  ],
  "blocks": [
    {
      "id": "block.a0.037.daily-routine.explanation",
      "type": "explanation",
      "text": {
        "pt-BR": "Use os verbos já conhecidos com horários e advérbios de frequência para montar uma rotina curta. Wake up, start e finish acrescentam ações comuns do dia."
      }
    },
    {
      "id": "block.a0.037.daily-routine.vocabulary",
      "type": "vocabulary",
      "text": {
        "pt-BR": "wake up = acordar; start = começar; finish = terminar."
      }
    },
    {
      "id": "block.a0.037.daily-routine.rule",
      "type": "rule",
      "text": {
        "pt-BR": "Para ligar uma ação a um horário neste recorte, use at + horário: at seven, at eight."
      }
    },
    {
      "id": "block.a0.037.daily-routine.example",
      "type": "example",
      "language": "en",
      "text": {
        "en": "I wake up at seven. I usually study at eight."
      }
    },
    {
      "id": "block.a0.037.daily-routine.checkpoint",
      "type": "checkpoint",
      "text": {
        "pt-BR": "Mantenha a frase curta: sujeito + frequência quando necessária + verbo + at + horário."
      }
    }
  ],
  "activityIds": ["activity.a0.037.describe-daily-routine"]
}
