  "blocks": [
    {
      "id": "block.a0.025.there-is-are.explanation",
      "type": "explanation",
      "text": {
        "pt-BR": "Use there is para uma coisa e there are para mais de uma. Nesta Lesson, foque primeiro na escolha singular/plural."
      }
    },
    {
      "id": "block.a0.025.there-is-are.rule",
      "type": "rule",
      "text": { "pt-BR": "there is + singular; there are + plural" }
    },
    {
      "id": "block.a0.025.there-is-are.example",
      "type": "example",
      "language": "en",
      "text": { "en": "There is a book. There are two books." }
    },
    {
      "id": "block.a0.025.there-is-are.checkpoint",
      "type": "checkpoint",
      "text": {
        "pt-BR": "Antes de escolher is ou are, identifique se o elemento é singular ou plural."
      }
    }
  ],
