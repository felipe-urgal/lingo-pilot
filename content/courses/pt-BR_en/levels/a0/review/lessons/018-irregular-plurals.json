  "blocks": [
    {
      "id": "block.a0.018.irregular.explanation",
      "type": "explanation",
      "text": {
        "pt-BR": "Alguns substantivos não formam o plural com -s ou -es e precisam ser aprendidos como pares."
      }
    },
    {
      "id": "block.a0.018.irregular.vocabulary",
      "type": "vocabulary",
      "language": "en",
      "text": { "en": "person → people · child → children" }
    },
    {
      "id": "block.a0.018.irregular.example",
      "type": "example",
      "language": "en",
      "text": { "en": "one child · two children" }
    },
    {
      "id": "block.a0.018.irregular.checkpoint",
      "type": "checkpoint",
      "text": {
        "pt-BR": "Não aplique a regra regular a estes pares: memorize a forma plural junto com o singular."
      }
    }
