  "blocks": [
    {
      "id": "block.a0.017.plural.explanation",
      "type": "explanation",
      "text": {
        "pt-BR": "Muitos substantivos formam o plural com -s. Alguns finais comuns usam -es."
      }
    },
    {
      "id": "block.a0.017.plural.rule",
      "type": "rule",
      "text": {
        "pt-BR": "Comece pelos padrões frequentes: book → books; class → classes."
      }
    },
    {
      "id": "block.a0.017.plural.example",
      "type": "example",
      "language": "en",
      "text": { "en": "one book · two books · one class · two classes" }
    },
    {
      "id": "block.a0.017.plural.checkpoint",
      "type": "checkpoint",
      "text": {
        "pt-BR": "Observe se a palavra aceita o padrão regular antes de aplicar -s ou -es."
      }
    }
  ],
  "activityIds": ["activity.a0.017.form-regular-plural"]
