      "id": "objective.a0.017.form-regular-plurals",
      "description": {
        "pt-BR": "Formar plurais regulares frequentes com -s e -es."
      }
    }
  ],
  "prerequisiteLessonIds": ["lesson.a0.016.articles-a-an"],
  "introducesConceptIds": ["concept.a0.grammar.regular-plurals"],
