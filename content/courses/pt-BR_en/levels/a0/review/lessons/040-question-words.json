  "blocks": [
    {
      "id": "block.a0.040.question-words.explanation",
      "type": "explanation",
      "text": {
        "pt-BR": "Question words indicam o tipo de informação procurada: what para coisa/informação, who para pessoa, where para lugar, when para tempo e how para modo/estado."
      }
    },
    {
      "id": "block.a0.040.question-words.vocabulary",
      "type": "vocabulary",
      "text": {
        "pt-BR": "what = o que/qual; who = quem; where = onde; when = quando; how = como."
      }
    },
    {
      "id": "block.a0.040.question-words.example",
      "type": "example",
      "language": "en",
      "text": { "en": "Where do you live? What do you eat? How are you?" }
    },
    {
      "id": "block.a0.040.question-words.checkpoint",
      "type": "checkpoint",
      "text": {
        "pt-BR": "Escolha primeiro a informação desejada; depois mantenha a estrutura de pergunta que você já estudou."
      }
    }
  ],
