  "vocabularyIds": ["vocab.phone"],
  "blocks": [
    {
      "id": "block.a0.012.personal-information.explanation",
      "type": "explanation",
      "text": {
        "pt-BR": "Para idade, o inglês usa be: I am 30 years old. Para telefone, use My phone number is... e leia os dígitos individualmente."
      }
    },
    {
      "id": "block.a0.012.personal-information.rule",
      "type": "rule",
      "text": {
        "pt-BR": "Não traduza idade com have. Use I am + número + years old."
      }
    },
    {
      "id": "block.a0.012.personal-information.example",
      "type": "example",
      "language": "en",
      "text": { "en": "I'm 30 years old. My phone number is 555-0120." }
    },
    {
      "id": "block.a0.012.personal-information.checkpoint",
      "type": "checkpoint",
      "text": {
        "pt-BR": "Pratique uma idade e um telefone fictícios; não use dados pessoais reais durante o exercício."
      }
    }
  ],
  "activityIds": ["activity.a0.012.state-age-phone"]
