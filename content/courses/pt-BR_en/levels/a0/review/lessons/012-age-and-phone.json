    {
      "id": "objective.a0.012.state-age-phone",
      "description": {
        "pt-BR": "Informar idade e número de telefone usando estruturas curtas e números já estudados."
      }
    }
  ],
  "prerequisiteLessonIds": ["lesson.a0.011.numbers-20-100"],
  "introducesConceptIds": ["concept.a0.communication.age-and-phone"],
  "reinforcesConceptIds": [
