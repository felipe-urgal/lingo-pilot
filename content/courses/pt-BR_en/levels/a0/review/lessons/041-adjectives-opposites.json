      "type": "explanation",
      "text": {
        "pt-BR": "Adjetivos descrevem qualidades. Pratique pares de contraste para reduzir a carga de memória."
      }
    },
    {
      "id": "block.a0.041.adjectives.vocabulary",
      "type": "vocabulary",
      "text": {
        "pt-BR": "big/small = grande/pequeno; new/old = novo/velho ou antigo; good/bad = bom/ruim."
      }
    },
    {
      "id": "block.a0.041.adjectives.example",
      "type": "example",
      "language": "en",
      "text": { "en": "My book is new. My bag is small." }
