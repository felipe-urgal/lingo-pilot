  "blocks": [
    {
      "id": "block.a0.031.essential-verbs.explanation",
      "type": "explanation",
      "text": {
        "pt-BR": "Estes verbos aparecem com muita frequência quando falamos de rotina e fatos: go, work, live, study, eat e drink."
      }
    },
    {
      "id": "block.a0.031.essential-verbs.vocabulary",
      "type": "vocabulary",
      "text": {
        "pt-BR": "go = ir; work = trabalhar; live = morar; study = estudar; eat = comer; drink = beber."
      }
    },
    {
      "id": "block.a0.031.essential-verbs.example",
      "type": "example",
      "language": "en",
      "text": { "en": "I study. You work. We eat. They drink." }
    },
    {
      "id": "block.a0.031.essential-verbs.checkpoint",
      "type": "checkpoint",
      "text": {
        "pt-BR": "Primeiro reconheça o significado do verbo. A forma do simple present será organizada nas próximas aulas."
      }
    }
  ],
