      "language": "en",
      "text": {
        "en": "Good morning! — Good morning!"
      }
    },
    {
      "id": "block.a0.002.greetings.common-error",
      "type": "common-error",
      "text": {
        "pt-BR": "Goodbye é usado para encerrar uma troca. Para iniciar a conversa, escolha um cumprimento como hello, hi ou good morning conforme o contexto."
