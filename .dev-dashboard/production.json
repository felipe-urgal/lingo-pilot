{
  "version": 1,
  "production": {
    "enabled": true,
    "strategy": "git-managed",
    "provider": "vercel",
    "branch": "main",
    "documentation": "docs/PRODUCTION_STATUS.md",
    "commands": {
      "status": "prod:status",
      "check": "prod:check",
      "migrate": "prod:migrate",
      "verify": "prod:verify",
      "backup": "prod:backup",
      "restoreCheck": "prod:restore-check"
    },
    "health": {
      "type": "http",
      "url": "https://lingo-pilot.vercel.app/api/health/ready"
    },
    "external": {
      "project": "lingo-pilot"
    },
    "policies": {
      "backup": "required-before-risky-migration",
      "migrations": "explicit-before-deploy",
      "rollback": "app-rollback-or-forward-fix"
    }
  }
}
