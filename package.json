{
  "name": "lingo-pilot",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@lingo-pilot/web",
    "dev:e2e": "turbo run dev:e2e --filter=@lingo-pilot/web",
    "build": "node scripts/run-with-runtime-env.mjs turbo run build",
    "start": "node scripts/run-with-runtime-env.mjs pnpm --filter @lingo-pilot/web start",
    "prepare": "node scripts/install-git-hooks.mjs",
    "env:init": "node scripts/init-local-env.mjs",
    "env:check": "node scripts/check-local-env.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes && docker compose up -d --wait postgres && node scripts/run-with-runtime-env.mjs pnpm --filter @lingo-pilot/db db:migrate",
    "db:generate": "pnpm --filter @lingo-pilot/db db:generate",
    "db:migrate": "node scripts/run-with-runtime-env.mjs pnpm --filter @lingo-pilot/db db:migrate",
    "db:check": "pnpm --filter @lingo-pilot/db db:check",
    "db:smoke": "node scripts/run-with-runtime-env.mjs pnpm --filter @lingo-pilot/db db:smoke",
    "lint": "eslint scripts tests vitest.config.ts playwright.config.ts packages/config/runtime --max-warnings 0 && turbo run lint && pnpm check:workspace",
    "typecheck": "node scripts/run-with-runtime-env.mjs turbo run typecheck",
    "test:unit": "node --test tests/*.test.mjs && vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node scripts/run-with-runtime-env.mjs pnpm --filter @lingo-pilot/db test:integration",
    "test:e2e": "node scripts/run-with-runtime-env.mjs node scripts/run-e2e.mjs",
    "test": "pnpm test:unit && pnpm test:integration",
    "content:validate": "pnpm --filter @lingo-pilot/content validate",
    "check:workspace": "node scripts/verify-workspace.mjs",
    "check": "pnpm format:check && pnpm env:check && pnpm lint && pnpm typecheck && pnpm test && pnpm content:validate && pnpm db:check && pnpm build",
    "prod:status": "node scripts/production-status.mjs",
    "prod:prepare": "pnpm db:up",
    "prod:check": "node scripts/prod-check.mjs",
    "prod:migrate": "node scripts/migrate-production.mjs",
    "prod:verify": "node scripts/verify-production.mjs",
    "prod:backup": "node scripts/backup-production.mjs",
    "prod:restore-check": "node scripts/restore-check-production.mjs",
    "format": "prettier --write .",
    "format:staged": "node scripts/format-staged.mjs",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@lingo-pilot/config": "workspace:*",
    "@playwright/test": "1.62.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "turbo": "2.10.11",
    "vitest": "4.1.11"
  }
}
